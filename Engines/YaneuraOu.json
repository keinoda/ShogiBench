{
    "private" : false,
    "nps"     : 1000000,
    "source"  : "https://github.com/keinoda/YaneuraOu",

    "build" : {
        "path"      : "source",
        "compilers" : ["clang++>=16"],
        "cpuflags"  : ["AVX2"],
        "systems"   : ["Linux"],

        "binary"               : "YaneuraOu-by-gcc",
        "network_option"       : "EvalDir",
        "network_filename"     : "nn.bin",
        "network_aux_option"   : "ProgressFilePath",
        "network_aux_filename" : "progress.bin",
        "bench_args"           : "16 1 100000 default nodes",

        "variants"  : {
            "default"                : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE",
            "NNUE-halfKP256"         : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE",
            "NNUE-KP256"             : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE_KP256",
            "NNUE-halfKPE9"          : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE_HALFKPE9",
            "NNUE-halfKP512x2-16-32" : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE_HALFKP_512X2_16_32",
            "NNUE-halfKP1024x2-8-32" : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE_HALFKP_1024X2_8_32",
            "NNUE-halfKP1024x2-8-64" : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE_HALFKP_1024X2_8_64",
            "NNUE-halfKPvm256x2"     : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE_HALFKP_VM_256X2_32_32",
            "SFNN1536"               : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_SFNN1536",
            "MATERIAL(動作確認用)"    : "normal COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_MATERIAL",
            "tournament"             : "tournament COMPILER=clang++ TARGET_CPU=AVX2 YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE"
        }
    },

    "test_presets" : {
        "default" : {
            "base_branch"     : "master",
            "book_name"       : "6moves_v1_shogi_sfen.epd",
            "test_bounds"     : "[0.00, 4.00]",
            "test_confidence" : "[0.10, 0.05]",
            "win_adj"         : "movecount=3 score=2000",
            "draw_adj"        : "movenumber=40 movecount=8 score=10"
        },

        "STC" : {
            "both_options"      : "Threads=1 Hash=64",
            "both_time_control" : "8.0+0.08",
            "workload_size"     : 32
        },

        "LTC" : {
            "both_options"      : "Threads=1 Hash=256",
            "both_time_control" : "40.0+0.4",
            "workload_size"     : 8
        },

        "25k nodes" : {
            "both_options"      : "Threads=1 Hash=64",
            "both_time_control" : "N=25000",
            "workload_size"     : 128
        }
    },

    "tune_presets" : {
        "default" : {
            "book_name" : "6moves_v1_shogi_sfen.epd",
            "win_adj"   : "movecount=3 score=2000",
            "draw_adj"  : "movenumber=40 movecount=8 score=10"
        }
    }
}
